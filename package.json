{
  "name": "react-loading-kit",
  "version": "0.1.0",
  "description": "Zero-dependency, accessible loading states, spinners, and skeleton loaders for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "dev": "tsup --watch",
    "lint": "eslint src demo/src"
  },
  "author": "Moaz Karem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoazKarem42/react-loading-package.git"
  },
  "homepage": "https://github.com/MoazKarem42/react-loading-package#readme",
  "bugs": {
    "url": "https://github.com/MoazKarem42/react-loading-package/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  },
  "keywords": [
    "react",
    "loading",
    "spinner",
    "skeleton",
    "loaders",
    "indicators",
    "accessibility",
    "zero-dependency",
    "spinners",
    "skeletons"
  ]
}
